# pg_hba.conf lines for Admit. Identity comes from the OS or from a client certificate, never from the agent.
# The database cannot tell a second OS user from a second machine, and does not need to: identity is the role.
#
# The verifier's legacy SQL login is grader_role; keep installed mappings compatible.
# Same box, two OS users (worker, verifier), bound by a pg_ident map:
# Use the existing verifier OS account name; this example does not rename users or mappings.
local    admit    actor_role     peer    map=admit
local    admit    grader_role    peer    map=admit
#
# Another box for the verifier, bound by a client certificate:
hostssl  admit    grader_role    10.0.2.0/24    cert    clientcert=verify-full
#
# Nobody logs in as the owner:
local    admit    admit_owner    reject
host     admit    admit_owner    0.0.0.0/0      reject
host     admit    admit_owner    ::/0           reject

# pg_ident.conf
# MAPNAME   SYSTEM-USERNAME   PG-USERNAME
# admit     worker            actor_role
# admit     verifier          grader_role
